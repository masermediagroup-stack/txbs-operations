# Use demo only for the disposable validation project; shared requires both values below.
NEXT_PUBLIC_TBS_MODE=shared
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_APP_URL=https://your-demo-domain.vercel.app
APP_ENVIRONMENT=temporary
INVENTORY_DATA_BACKEND=supabase
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=TBS Operations <onboarding@resend.dev>
RESEND_REPLY_TO=tyler.vea@txbspecialties.com

# Server-only: required to verify immutable uploaded bytes; never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_server_only
# The reviewed policy is enforced. Use 0 only for an explicit diagnostic deployment.
TBS_CSP_ENFORCE=1
